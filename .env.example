# Copy to backend/.env and fill in. NEVER commit the real .env file.
FLASK_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-random-32+-char-string
JWT_SECRET_KEY=replace-with-different-random-32+-char-string
# MAIN USER (Super Admin), created on deploy. Password min 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: also create one demo account per role (farmer, extension officer, buyer, seller,
# operations/marketplace/ai/support admin). Password min 12 chars. Turn OFF when finished.
SEED_ROLE_USERS=false
SEED_USERS_PASSWORD=
SEED_USERS_DOMAIN=
IMAGE_RETENTION_DAYS=365
# AI providers (one key per provider - never reuse across providers)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=
DISEASE_MODEL_URL=https://api-inference.huggingface.co/models/linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
SOIL_MODEL_URL=https://api-inference.huggingface.co/models/google/vit-base-patch16-224
OPENWEATHER_API_KEY=
FRONTEND_URL=http://localhost:5173
# Optional
CORS_EXTRA_ORIGINS=
DB_SSL_VERIFY=false
SEED_DEMO_DATA=false
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
